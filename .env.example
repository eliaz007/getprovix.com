# =============================================================================
# Provix environment template
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
# Never commit real secrets. Values below are intentionally blank.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# Public site origin used for OAuth redirects, emails, and Stripe return URLs.
# Local: http://localhost:3000
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Supabase
# Project Settings → API: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# GitHub App
# Create/manage at: https://github.com/settings/apps
# Private key: paste the full PEM (use \n for newlines in a single line, or a
# multiline quoted value). Slug is the /apps/<slug> segment.
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional override when OAuth callback origin differs from NEXT_PUBLIC_APP_URL.
GITHUB_APP_REDIRECT_ORIGIN=
# Webhook → Secret on the GitHub App settings page.
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# GitHub tokens (fallback when App install/token is unavailable)
# Prefer the GitHub App. PAT is a secondary path for local/dev access.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_PAT=

# -----------------------------------------------------------------------------
# Google Gemini (AI audit / match / agentic autofix routes)
# https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Resend (transactional email)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Stripe (checkout / candidate unlock)
# https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Feature flags (optional)
# PROVIX_AGENTIC_CLIENT_DB=1 enables agentic client-DB autofix paths.
# PROVIX_AUTONOMOUS_WEBHOOK_HEAL=true enables autonomous webhook heal.
# -----------------------------------------------------------------------------
PROVIX_AGENTIC_CLIENT_DB=
PROVIX_AUTONOMOUS_WEBHOOK_HEAL=

# -----------------------------------------------------------------------------
# PVIM shadow analysis (optional secondary scanner)
# Set PVIM_SHADOW_ENABLED=true and provide URL + service token to enable.
# -----------------------------------------------------------------------------
PVIM_SHADOW_ENABLED=
PVIM_SHADOW_URL=
PVIM_SERVICE_TOKEN=
# Optional request timeout in milliseconds (default 10000).
PVIM_SHADOW_TIMEOUT_MS=
